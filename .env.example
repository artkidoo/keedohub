# KeedoHub environment template — copy to .env and fill in.
# Never commit the real .env.

# PostgreSQL connection used by Drizzle and Better Auth.
DATABASE_URL=postgresql://user:password@localhost:5432/keedohub

# Better Auth secret — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Public origin of the app (used by Better Auth for cookies/redirects).
BETTER_AUTH_URL=http://localhost:3000

# Extra origins Better Auth trusts (comma-separated, production only).
# Empty in development. Each entry must be an https: URL in production, e.g.
# AUTH_TRUSTED_ORIGINS=https://app.keedohub.com,https://preview-123.keedohub.com
# A malformed value fails server startup loudly rather than widening trust.
AUTH_TRUSTED_ORIGINS=

# Rate-limit backend (Phase 5.2B): single-instance memory limiter is active.
# For multi-instance hosting, set RATE_LIMIT_REDIS_URL to an Upstash/Redis
# REST URL and implement the RedisRateLimitStore seam in src/lib/rate-limit.ts;
# without a backend the memory limiter must NOT be treated as distributed.
# RATE_LIMIT_REDIS_URL=

# Storage provider for uploaded assets.
#   local — store on the local filesystem (default, requires STORAGE_LOCAL_BASE_DIR)
#   s3    — store in an S3-compatible bucket (validated once at server startup
#           by instrumentation.ts; every S3_* variable below is required and a
#           missing one fails boot loudly — production never falls back to disk)
STORAGE_PROVIDER=local
# Absolute base directory for the local storage provider.
STORAGE_LOCAL_BASE_DIR=/var/lib/keedohub/storage

# S3-compatible object storage (production). Placeholders only — never commit
# real credentials. Server-side only: none of these uses NEXT_PUBLIC_*.
#   S3_ENDPOINT — base URL, e.g. https://s3.eu-west-2.amazonaws.com for AWS S3,
#     or the MinIO / Cloudflare R2 / compatible endpoint in use.
#   S3_REGION — AWS region for SigV4 signing (required even on custom endpoints).
#   S3_BUCKET — private bucket holding KeedoHub assets.
#   S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY — server-side credentials.
#   S3_FORCE_PATH_STYLE — set "true" for MinIO-style path addressing
#     (endpoint/bucket/key); virtual-hosted style is default.
S3_ENDPOINT=https://s3.eu-west-2.amazonaws.com
S3_REGION=eu-west-2
S3_BUCKET=keedohub-assets
S3_ACCESS_KEY_ID=replace-with-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-secret-access-key
S3_FORCE_PATH_STYLE=false
